# Production: TLS URL for SELECT-only role; never expose to browser.
APP_DATABASE_URL=postgresql+psycopg://studio_reader:REPLACE@HOST/studio?sslmode=require
# Migration/seed job ONLY; do not put this in the deployed app's runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:REPLACE@HOST/studio?sslmode=require
OWNER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_SALT_COLON_HASH
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# STUDIO_LOCAL=1 is only for loopback HTTP; leave unset on hosted deployments.

# Phase two: server-side only; live calls require separately verified benefits.
STUDIO_WRITER_DATABASE_URL=
NEBIUS_API_KEY=
FIREWORKS_API_KEY=
MEM0_API_KEY=
LANGSMITH_API_KEY=
STUDIO_MODEL_PROVIDER=
STUDIO_MODEL_ID=
# Tracing stays local until external benefit/spending verification is complete.
LANGSMITH_TRACING=false
MEM0_TELEMETRY=false
